# Скопируйте в deploy/.env на сервере. Файл в git не попадает.
POSTGRES_PASSWORD=замените_длинным_паролем
SECRET_KEY=замените_длинной_случайной_строкой
DADATA_KEY=
DADATA_DAILY_LIMIT=200
BOOTSTRAP_ADMIN_EMAIL=admin@dok.moscow
BOOTSTRAP_ADMIN_PASSWORD=замените_пароль_админа

# Лендинг / заявки (W-08)
PUBLIC_BASE_URL=https://dok.moscow
APP_BASE_URL=https://app.dok.moscow
YANDEX_METRIKA_ID=
# W-25: Яндекс ID OAuth (Client secret только здесь / в секретах, не в git)
YANDEX_CLIENT_ID=453c829f555c4e94a1f77c16313854a9
YANDEX_CLIENT_SECRET=
# Должен совпадать с Redirect URI в кабинете Яндекс OAuth и с хостом /login
YANDEX_REDIRECT_URI=https://app.dok.moscow/auth/yandex/callback
SESSION_HTTPS_ONLY=true
# Не задавать SESSION_COOKIE_DOMAIN на проде dual-host (cookie только app).
# SESSION_COOKIE_DOMAIN=.dok.moscow
# T1: на проде не включать
DB_AUTO_CREATE=false
ADMIN_NOTIFY_EMAIL=admin@dok.moscow
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Необязательно: каталог внешних бэкапов и ключ age для шифрования
BACKUP_DIR=/var/backups/dok
BACKUP_REMOTE=          # например: user@backup-host:/path или s3://bucket/dok
AGE_RECIPIENT=          # age1... — если задан, архивы шифруются age
BACKUP_REQUIRE_AGE=1    # на проде: 1 — не сохранять незашифрованные бэкапы

# W-10 биллинг: окончание бета-подписки «Специалист» для организаций без оплаты
BETA_TRIAL_UNTIL=2026-10-01
# W-11: фоновая сверка GetState / автопродление (0 — выключить)
BILLING_WORKER=1

# W-46: данные вне git; host-путь == путь в контейнере
# FILES_ROOT=/srv/dok/data/files
# (задаётся в compose environment; переопределение через .env допустимо)

# W-46 фаза D: прод только из GHCR (deploy.sh без DOK_IMAGE/--tag — отказ)
# DOK_IMAGE=ghcr.io/sudexpertpsy-afk/dok-app:v1.0.0
# APP_VERSION=v1.0.0
# GHCR_IMAGE=ghcr.io/sudexpertpsy-afk/dok-app
# GHCR_USER=sudexpertpsy-afk
# GHCR_TOKEN=  # fine-grained PAT, только read:packages, ≤90 дней; не коммитить

# W-34: ops-agent (внутренний контейнер; порт наружу не публиковать)
OPS_AGENT_ENABLED=false
OPS_AGENT_URL=http://ops-agent:9100
# ≥32 байт; на проде сгенерировать: openssl rand -base64 48
OPS_AGENT_TOKEN=
HOSTLAND_PANEL_URL=https://hostland.ru/
HOSTLAND_PAY_URL=https://hostland.ru/
HOSTLAND_CONSOLE_URL=https://hostland.ru/
# W-43: выключить факсимиле при инциденте (генерация документов не ломается)
FAKSIMILE_ENABLED=true
# GPG_RECIPIENT=admin@dok.moscow   # альтернатива age (если AGE_RECIPIENT пуст)
# AGE_IDENTITY=/root/.age/key.txt   # только для restore.sh зашифрованных архивов
