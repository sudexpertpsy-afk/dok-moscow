# Скопируйте в deploy/.env на сервере. Файл в git не попадает.
POSTGRES_PASSWORD=замените_длинным_паролем
SECRET_KEY=замените_длинной_случайной_строкой
DADATA_KEY=
DADATA_DAILY_LIMIT=200
BOOTSTRAP_ADMIN_EMAIL=admin@dok.moscow
BOOTSTRAP_ADMIN_PASSWORD=замените_пароль_админа

# Лендинг / заявки (W-08)
PUBLIC_BASE_URL=https://dok.moscow
APP_BASE_URL=https://app.dok.moscow
YANDEX_METRIKA_ID=
ADMIN_NOTIFY_EMAIL=admin@dok.moscow
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Необязательно: каталог внешних бэкапов и ключ age для шифрования
BACKUP_DIR=/var/backups/dok
BACKUP_REMOTE=          # например: user@backup-host:/path или s3://bucket/dok
AGE_RECIPIENT=          # age1... — если задан, архивы шифруются age
# AGE_IDENTITY=/root/.age/key.txt   # только для restore.sh зашифрованных архивов
