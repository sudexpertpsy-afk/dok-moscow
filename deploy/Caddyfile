# Авто-HTTPS Let's Encrypt через Caddy.
# DNS A-записи dok.moscow и app.dok.moscow → IP VDS.

dok.moscow, www.dok.moscow {
	encode zstd gzip

	# 410 Gone — сканеры WordPress / мусорные пути (до FastAPI не доходят)
	@wp_junk_path {
		path /wp-* /xmlrpc.php /license.txt /readme.html
	}
	handle @wp_junk_path {
		respond 410
	}
	@wp_junk_re path_regexp wp_content ^/wp-content/
	handle @wp_junk_re {
		respond 410
	}

	# 301 → / для кириллических URL прежнего WP-сайта (латиницу не трогаем:
	# иначе сломаются /privacy, /contacts, /static, …)
	@legacy_cyr path_regexp cyrillic ^/[а-яА-ЯёЁ]
	redir @legacy_cyr / 301

	# 301 → / для архивных /YYYY/MM/
	@legacy_year path_regexp year_archive ^/20[12][0-9]/[0-1][0-9]/?$
	redir @legacy_year / 301

	# W-31: хэшированная статика — год; PDF-образцы — сутки
	@static_hashed path_regexp hashed_static ^/static/.+\.[a-f0-9]{8,}\.(css|js)$
	header @static_hashed Cache-Control "public, max-age=31536000, immutable"
	@static_samples path /static/samples/*
	header @static_samples Cache-Control "public, max-age=86400"
	@static_other {
		path /static/*
		not path_regexp hashed_static ^/static/.+\.[a-f0-9]{8,}\.(css|js)$
		not path /static/samples/*
	}
	header @static_other Cache-Control "public, max-age=604800"

	reverse_proxy app:8000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

app.dok.moscow {
	encode zstd gzip

	@static_hashed path_regexp hashed_static_app ^/static/.+\.[a-f0-9]{8,}\.(css|js)$
	header @static_hashed Cache-Control "public, max-age=31536000, immutable"
	@static_samples path /static/samples/*
	header @static_samples Cache-Control "public, max-age=86400"
	@static_other {
		path /static/*
		not path_regexp hashed_static_app ^/static/.+\.[a-f0-9]{8,}\.(css|js)$
		not path /static/samples/*
	}
	header @static_other Cache-Control "public, max-age=604800"

	# Кабинетные HTML — не кэшировать на краю
	@html_pages {
		not path /static/*
		not path /api/*
		not path /billing/webhook
	}
	header @html_pages Cache-Control "no-store"

	reverse_proxy app:8000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
