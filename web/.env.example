# Скопируйте в web/.env для локального запуска (не коммитить).
SECRET_KEY=замените_длинной_случайной_строкой
# Локально можно SQLite; для W-02+ предпочтителен PostgreSQL 16:
# DB_URL=sqlite+pysqlite:////tmp/dok_moscow_dev.db
DB_URL=postgresql+psycopg://dok:dok_dev_pass@127.0.0.1:5432/dok
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=замените_пароль
FILES_ROOT=/tmp/dok_files
GOTENBERG_URL=http://127.0.0.1:3000
DADATA_KEY=
DADATA_DAILY_LIMIT=200
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_BASE_URL=http://127.0.0.1:8000
YANDEX_METRIKA_ID=
# W-25: Яндекс ID OAuth (секрет только из окружения, не коммитить)
YANDEX_CLIENT_ID=453c829f555c4e94a1f77c16313854a9
YANDEX_CLIENT_SECRET=
# Прод: https://app.dok.moscow/auth/yandex/callback (тот же хост, что /login)
YANDEX_REDIRECT_URI=http://127.0.0.1:8000/auth/yandex/callback
SESSION_HTTPS_ONLY=false
# W-30: в тестах/локально без worker — выполнять PDF-jobs в процессе web
JOBS_INLINE=true
BILLING_WORKER=0
# W-10: конец бета-подписки (календарный день Europe/Moscow, не 23:59 UTC)
BETA_TRIAL_UNTIL=2026-10-01
# T1: схема БД — alembic upgrade head. create_all только если true (быстрый sqlite без миграций).
# На проде и в docker не задавать / false.
DB_AUTO_CREATE=false
# W-34: локально обычно выключено
OPS_AGENT_ENABLED=false
OPS_AGENT_URL=http://127.0.0.1:9100
OPS_AGENT_TOKEN=
HOSTLAND_PANEL_URL=https://hostland.ru/
HOSTLAND_PAY_URL=https://hostland.ru/
HOSTLAND_CONSOLE_URL=https://hostland.ru/
ADMIN_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
