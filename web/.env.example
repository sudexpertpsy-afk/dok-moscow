# Скопируйте в web/.env для локального запуска (не коммитить).
SECRET_KEY=замените_длинной_случайной_строкой
# Локально можно SQLite; для W-02+ предпочтителен PostgreSQL 16:
# DB_URL=sqlite+pysqlite:////tmp/dok_moscow_dev.db
DB_URL=postgresql+psycopg://dok:dok_dev_pass@127.0.0.1:5432/dok
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=замените_пароль
FILES_ROOT=/tmp/dok_files
GOTENBERG_URL=http://127.0.0.1:3000
